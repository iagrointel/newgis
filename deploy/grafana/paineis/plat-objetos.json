      "type": "stat",
      "title": "Agrupamento saudável",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "plat-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "plat-prometheus"
          },
          "expr": "max(cluster_healthy{job=\"plat-garage\"})",
          "refId": "A",
          "legendFormat": "1 = saudável",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
