# Exemplo OPCIONAL de repasse de tile vetorial direto ao Martin (itens L2-01-mapa-web / L2-01-b).
# NÃO é instalado: o install.sh só lê deploy/nginx.conf. Para usar, cole os dois blocos abaixo dentro
# do server{} 443 de deploy/nginx.conf (antes de `location /`) e troque PORTA pela porta da API.
#
# Por que fica fora do modelo instalado: o caminho ligado por padrão é o repasse pela própria
# plataforma (a rota /tiles/... de app/mapa/rotas.py, servida pelo bloco raiz), porque é o caminho que
# a suíte prova de ponta a ponta e o único que funciona no appliance sem nginx. O contrato de URL é o
# mesmo nos dois; o que muda é quem serve. Este arquivo tira o Python do caminho do tile sob carga: o
# nginx valida o token com auth_request (a MESMA função de autorização, app/tiles/rotas.autorizar) e
# repassa direto ao Martin em 127.0.0.1:8151.
#
# Armadilha do nginx: add_header dentro de um bloco cancela os herdados do server{}. O bloco
# externo abaixo repete o conjunto inteiro de cabeçalhos de segurança; o bloco de auth_request é
# interno (nunca responde a um navegador) e por isso não leva cabeçalho nenhum.

location /tiles/ {
    auth_request /internal/tiles/verificar;
    auth_request_set $motivo $upstream_http_x_motivo_recusa;
    proxy_pass http://127.0.0.1:8151/;
    proxy_set_header X-Real-IP $remote_addr;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}

location = /internal/tiles/verificar {
    internal;
    proxy_pass http://127.0.0.1:PORTA;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Uri $request_uri;
    proxy_set_header X-Real-IP $remote_addr;
}
