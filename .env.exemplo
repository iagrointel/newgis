# Configuração do plat (ADR 0001 seção 8). Copie para .env (modo 600) ou deixe o install.sh criar.
PLAT_DSN=postgresql://plat_app:troque-esta-senha@127.0.0.1:5432/iagro_sat
PLAT_AMBIENTE=dev
# PLAT_SECRET e PLAT_DSN_WORKER NÃO vão neste arquivo (item L7-19-segredos-e-certificados): o
# install.sh os gera/migra em /etc/plat/segredos/ (dono root, 0600), entregues aos serviços por
# LoadCredential= do systemd — nunca em .env. Detalhe e rotação em docs/SEGURANCA.md.
# liga plat.jobs_semear_demo (migração 014): semeadura de jobs TERMINAIS nos inquilinos de demonstração
# (demo, demo2, zt-*), usada pelo e2e dos 1.000 jobs. Automático quando PLAT_AMBIENTE=dev; em servidor de
# análise/beta que roda a suíte com PLAT_AMBIENTE=producao, ligar aqui. Instalação de cliente: deixar de fora.
PLAT_SEMENTE_DEMO=nao
PLAT_URL_PUBLICA=https://plat.iagrointel.com
PLAT_GIT_SHA=
PLAT_MARTIN_URL=
PLAT_TITILER_URL=
PLAT_GARAGE_URL=http://127.0.0.1:3900
# arquivos/objetos (L0-11; ADR 0006): admin api do garage (:3903, plataforma-garage já em produção), bearer token
# do garage.toml [admin]; nunca chega ao navegador, só o backend chama para criar bucket/chave/cota por inquilino
PLAT_GARAGE_ADMIN_URL=http://127.0.0.1:3903
PLAT_GARAGE_ADMIN_TOKEN=
PLAT_GARAGE_REGIAO=garage
PLAT_GARAGE_BUCKET_PREFIXO=plat-
# rede de rota (L2-11-c): OSRM isolado plat-osrm-guarulhos, recorte de teste (127.0.0.1:5010; nunca os OSRM de
# outras frentes da casa em 5000-5003). Vazio = padrão http://127.0.0.1:5010 e os tetos de app/limites.py.
PLAT_OSRM_URL=
PLAT_ROTA_MATRIZ_MAX=
PLAT_ROTA_ISOCRONA_MAX_PONTOS=
PLAT_LOG_NIVEL=INFO
# fila de jobs e worker plat-worker (ADR 0003 seção 11)
PLAT_WORKER_URL=http://127.0.0.1:8153
PLAT_WORKER_NOME=
PLAT_WORKER_PROCESSOS=1
PLAT_WORKER_MEMORIA_MB=1536
PLAT_JOBS_DIR=
PLAT_JOB_MAX_REINICIOS=5
PLAT_GPU_SSH=
PLAT_GPU_DIR=
PLAT_RELOGIO_TESTE=
# catálogo (ADR 0004 11.3): adaptador local de objetos até o L0-11; vazio = <repo>/var/dados
PLAT_DADOS_DIR=
