#!/usr/bin/env bash
# `plat` — ponto de entrada ÚNICO da linha de comando de administração (item L0-14-cli-admin).
# O código vive em app/cli/; este arquivo só escolhe o interpretador da venv do projeto (nunca o do
# sistema) e repassa os argumentos. `venv/bin/plat` é um vínculo simbólico para cá, criado pelo install.sh.
#
# Uso: scripts/plat --help
set -euo pipefail
RAIZ="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="$RAIZ/venv/bin/python"
[ -x "$PY" ] || PY=python3
cd "$RAIZ"
exec "$PY" -m app.cli "$@"
