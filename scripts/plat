#!/usr/bin/env python3
"""`plat` — utilitário de linha de comando do administrador da plataforma.

Dois grupos, um ponto de entrada só (nunca um script novo por comando):

- `demo` (item L7-01-c-dado-demonstracao): semeia e confere o pacote de dado de demonstração. Roda de
  dentro do repositório, lendo a base venv/ do próprio worktree; não faz nada sozinho, fala com a API já
  no ar (--base-url), a mesma que o navegador usa.
- `modo` (item L7-33-modo-somente-leitura): liga, desliga e mostra o modo somente-leitura/manutenção,
  global ou de um inquilino. Fala DIRETO com o banco pela role do worker (`PLAT_DSN_WORKER`), nunca pela
  API: a API não liga o próprio modo, e é isso que permite ligá-lo quando a API está fora do ar. Motivo é
  obrigatório nos dois sentidos e cada chamada grava uma linha em `plat.sistema_trilha`.
- `segredo rotacionar` (item L7-19-segredos-e-certificados): repassa para `scripts/segredo_rotacionar.py`,
  rodado pelo Python do venv, como antes. Procedimento completo em docs/RUNBOOKS/segredos.md.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(RAIZ))

from dados.demo import semear as demo_semear  # noqa: E402


def cmd_demo_semear(a: argparse.Namespace) -> int:
    medida = Path(a.medida) if a.medida else None
    resumo = demo_semear.semear(a.base_url, Path(a.credenciais), medida, verboso=not a.silencioso)
    print(json.dumps(resumo, ensure_ascii=False, indent=2 if not a.silencioso else None))
    return 0


def cmd_demo_verificar(a: argparse.Namespace) -> int:
    resultado = demo_semear.verificar(a.base_url, Path(a.credenciais), verboso=not a.silencioso)
    print(json.dumps(resultado, ensure_ascii=False, indent=2))
    return 0 if resultado["ok"] else 1


# ---------------------------------------------------------------- modo (item L7-33-modo-somente-leitura)
def _conexao_worker():
    """Conexão como `plat_worker`, a única role com EXECUTE em plat.modo_ligar/modo_desligar (migração
    20260906T2109). CursorSchemaAmbiente porque o SQL abaixo escreve `plat.` literal: sem a reescrita, uma
    trilha com PLAT_SCHEMA próprio iria bater no schema de produção (mesma razão do conftest da suíte)."""
    import psycopg2

    from app.schema_ambiente import CursorSchemaAmbiente

    dsn = os.environ.get("PLAT_DSN_WORKER")
    if not dsn:
        raise ErroModo("PLAT_DSN_WORKER não está no ambiente: o modo é escrito pela role do worker")
    con = psycopg2.connect(dsn, cursor_factory=CursorSchemaAmbiente)
    con.autocommit = True
    return con


class ErroModo(Exception):
    pass


def _quem() -> str:
    """Quem ligou/desligou vai para a trilha. Sem valor bom, `plat.modo_ligar` recusa (quem obrigatório)."""
    return (os.environ.get("PLAT_OPERADOR") or os.environ.get("SUDO_USER")
            or os.environ.get("USER") or "desconhecido")


def _tenant_id(cur, slug: str) -> int:
    cur.execute("SELECT id FROM plat.tenant WHERE slug = %s", (slug,))
    linha = cur.fetchone()
    if not linha:
        raise ErroModo(f"inquilino inexistente: {slug}")
    return linha["id"] if isinstance(linha, dict) else linha[0]


def _um_valor(linha):
    if linha is None:
        raise ErroModo("a função do banco não devolveu resultado")
    return list(linha.values())[0] if isinstance(linha, dict) else linha[0]


def cmd_modo(a: argparse.Namespace) -> int:
    con = _conexao_worker()
    try:
        with con.cursor() as cur:
            escopo = "inquilino" if a.inquilino else "global"
            tid = _tenant_id(cur, a.inquilino) if a.inquilino else None
            if a.acao == "estado":
                cur.execute("SELECT plat.modo_ler(%s) AS v", (tid,))
            elif a.acao == "ligar":
                cur.execute("SELECT plat.modo_ligar(%s, %s, %s, %s, %s) AS v",
                            (escopo, tid, a.motivo, _quem(), a.retry_after))
            else:
                cur.execute("SELECT plat.modo_desligar(%s, %s, %s, %s) AS v",
                            (escopo, tid, a.motivo, _quem()))
            estado_atual = _um_valor(cur.fetchone())
    finally:
        con.close()
    print(json.dumps(estado_atual, ensure_ascii=False, default=str))
    return 0


def _repassar_segredo(extras: list[str]) -> int:
    """`plat segredo rotacionar ...` -> scripts/segredo_rotacionar.py, com o Python do venv.

    Fica FORA do argparse de propósito: as opções de rotação são do outro programa e mudam com ele; o
    dispatcher não deve conhecê-las nem validá-las (era o que o dispatcher em bash fazia antes desta
    junção, e é o contrato que docs/SEGURANCA.md e docs/RUNBOOKS/segredos.md descrevem)."""
    executavel = RAIZ / "venv" / "bin" / "python"
    if not executavel.exists():
        print(f"plat segredo rotacionar: venv ausente em {executavel}", file=sys.stderr)
        return 1
    os.execv(str(executavel), [str(executavel), str(RAIZ / "scripts" / "segredo_rotacionar.py"),
                               "rotacionar", *extras])
    return 1  # inalcançável: execv só volta se falhar, e aí levanta OSError


USO_SEGREDO = """uso: plat segredo rotacionar <NOME> [opções]

NOME em: PLAT_SECRET | PLAT_DSN | PLAT_DSN_WORKER | PLAT_GARAGE_ADMIN_TOKEN | PLAT_GARAGE_CHAVE_S3:<slug>

Ver docs/RUNBOOKS/segredos.md para o procedimento completo (o que cada segredo invalida, quando avisar
antes de rodar em produção com usuários ativos)."""


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if args[:1] == ["segredo"]:
        if args[1:2] == ["rotacionar"]:
            return _repassar_segredo(args[2:])
        print(USO_SEGREDO, file=sys.stderr)
        return 1

    p = argparse.ArgumentParser(prog="plat", description="utilitário de linha de comando da plataforma")
    sub = p.add_subparsers(dest="grupo", required=True)

    sub.add_parser("segredo", help="rotação de segredo (repassa para scripts/segredo_rotacionar.py)")
    demo = sub.add_parser("demo", help="pacote de dado de demonstração")
    demo_sub = demo.add_subparsers(dest="acao", required=True)

    p_semear = demo_sub.add_parser("semear", help="cria o inquilino demo/demo2 com os itens do catálogo")
    p_semear.add_argument("--base-url", default=os.environ.get("PLAT_URL_TESTE", "http://127.0.0.1:8150"))
    p_semear.add_argument(
        "--credenciais", default=os.environ.get("PLAT_CREDENCIAIS_ARQUIVO", str(RAIZ / "tests" / "credenciais.txt"))
    )
    p_semear.add_argument("--medida", default=None, help="grava o resultado e o tempo neste JSON")
    p_semear.add_argument("--silencioso", action="store_true")
    p_semear.set_defaults(func=cmd_demo_semear)

    p_verificar = demo_sub.add_parser("verificar", help="confere contagens e sha256 do pacote semeado")
    p_verificar.add_argument("--base-url", default=os.environ.get("PLAT_URL_TESTE", "http://127.0.0.1:8150"))
    p_verificar.add_argument(
        "--credenciais", default=os.environ.get("PLAT_CREDENCIAIS_ARQUIVO", str(RAIZ / "tests" / "credenciais.txt"))
    )
    p_verificar.add_argument("--silencioso", action="store_true")
    p_verificar.set_defaults(func=cmd_demo_verificar)

    # ------------------------------------------------------------ modo (item L7-33)
    modo = sub.add_parser("modo", help="modo somente-leitura/manutenção (global ou de um inquilino)")
    modo_sub = modo.add_subparsers(dest="acao", required=True)
    for acao, ajuda in (("ligar", "liga o modo (bloqueia escrita; mapa, leitura e exportação seguem)"),
                        ("desligar", "desliga o modo e devolve a escrita"),
                        ("estado", "mostra o estado efetivo sem mudar nada")):
        q = modo_sub.add_parser(acao, help=ajuda)
        q.add_argument("--inquilino", default=None, metavar="SLUG",
                       help="limita ao inquilino; sem isto o escopo é global")
        if acao != "estado":
            # motivo obrigatório é cláusula do portão do item, e o banco também o exige: vale nos dois
            # sentidos, porque a trilha tem de dizer por que a escrita voltou.
            q.add_argument("--motivo", required=True, help="por que (obrigatório; vai para a trilha)")
        if acao == "ligar":
            q.add_argument("--retry-after", type=int, default=300, metavar="S",
                           help="segundos no cabeçalho Retry-After das respostas 503 (padrão 300)")
        q.set_defaults(func=cmd_modo)

    a = p.parse_args(args)
    try:
        return a.func(a)
    except (demo_semear.Erro, ErroModo) as e:
        print(f"plat {a.grupo} {a.acao} falhou: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
