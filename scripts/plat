#!/bin/bash
# `plat` — ponto de entrada ÚNICO da linha de comando de administração (item L0-14-cli-admin, ADR
# docs/adr/20260907T2318-linha-de-comando-plat.md decisão 1: "ele não decide nada: escolhe o Python da
# venv e chama `python -m app.cli`").
#
# 18/09/2026: este arquivo havia sido SUBSTITUÍDO por um segundo utilitário de mesmo nome, vindo dos itens
# L7-01-c (grupo `demo`) e L7-19 (`segredo rotacionar`) — e com isso os grupos inquilino/usuario/token/
# camada/job/evento sumiram do executável, embora continuassem inteiros em app/cli/. Era o achado do
# adversário do T9 (16 de 16 testes de tests/api/test_cli_admin.py falhando com "invalid choice"). Os dois
# grupos que haviam tomado o lugar viraram subcomandos do parser único, onde `plat docs` os documenta.
set -euo pipefail
RAIZ="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$RAIZ/venv/bin/python"
[ -x "$PY" ] || PY=python3
cd "$RAIZ"
exec "$PY" -m app.cli "$@"
