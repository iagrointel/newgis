# Exceções de tests/unit/test_tokens_cor.py — item L0-14-identidade-visual, cláusula (a) do portão.
#
# ESTADO MEDIDO (turno 5): CSS do produto em ZERO literal de cor. Nenhuma linha de CSS aparece aqui, e o
# teste test_nenhum_css_do_produto_tem_literal_de_cor nem consulta este arquivo — nenhuma exceção nova de
# CSS é capaz de silenciá-lo.
#
# O que resta é JavaScript que NÃO pode ler var(--...) por construção: o estilo do MapLibre é JSON
# interpretado pelo canvas, a cena 3D é configuração de renderização e os gráficos são SVG puro montado em
# memória. Nesses lugares a cor é cartografia ou dado, nunca cromo do produto.
#
# FORMATO: `caminho/relativo @N  # motivo`. N é o número de LINHAS com literal de cor que o arquivo tem
# direito de ter, medido. Literal novo faz a contagem passar de N e reprova; limpeza feita sem baixar N
# também reprova, para a lista não envelhecer sozinha. As formas `caminho` (arquivo inteiro) e
# `caminho:linha` continuam aceitas para um caso pontual — hoje nenhum arquivo do produto as usa.
#
# Baixar um destes números é trabalho de verdade: exige uma ponte que leve o valor do token para dentro do
# JSON do MapLibre. Está registrado como item próprio, não escondido aqui.


# --- cartografia — paint do MapLibre e ferramentas sobre o canvas do mapa ---
web/js/catalogo/tipos/camada_vetorial.js @1         # miniatura MapLibre do tipo camada vetorial
web/js/catalogo/tipos/raster.js @1                  # miniatura MapLibre do tipo camada raster
web/js/legenda.js @3                                # legenda do mapa: fio fixo da amostra, mesma família da cartografia
web/js/mapa/desenho.js @5                           # ferramenta de desenho sobre o mapa: cor da geometria em curso
web/js/mapa/edicao.js @3                            # edição de geometria sobre o mapa
web/js/mapa/estilo.js @17                           # paint do MapLibre: JSON lido pelo canvas, não resolve var() — cópia documentada dos tokens escuros
web/js/mapa/estilo_editor.js @9                     # editor de estilo de CAMADA: a cor é dado do usuário, não cromo do produto
web/js/mapa/estilo_sugestao.js @1                   # sugestão de estilo de camada: a cor é dado
web/js/mapa/grafico_svg.js @8                       # gráfico em SVG puro sobreposto ao mapa: cor de série de dado
web/js/mapa/graficos.js @5                          # gráfico de série temporal sobre o mapa
web/js/mapa/impressao.js @11                        # paint do MapLibre para exportação e impressão do mapa
web/js/mapa/medicao.js @3                           # régua e medição sobre o mapa
web/js/mapa/motor.js @3                             # motor AMC sobre o mapa: paint do MapLibre
web/js/mapa/render_layout_entrada.js @1             # miniatura de layout sem base, MapLibre puro
web/js/mapa/rotas.js @3                             # traçado de rota sobre o mapa: paint do MapLibre
web/js/mapa/tabela.js @6                            # tabela de atributos com cor de célula por valor
web/js/mapa/tabela_atributos.js @2                  # tabela de atributos flutuante do mapa
web/js/sig/comparar.js @1                           # comparação de camadas do SIG: paint do MapLibre
web/js/sig/sig.js @2                                # mapa MapLibre do SIG
web/js/simbolos/galeria.js @1                       # miniatura MapLibre da galeria de símbolos

# --- rede de utilidades — diagramas em SVG de cor fixa (as mesmas do gerador do servidor) ---
web/js/rede/diagrama.js @3                          # diagrama unifilar da rede: mesmas cores de app/rede_utilidades/diagrama.py
web/js/rede/fluxo.js @4                             # diagrama de fluxo da rede de utilidades: SVG de cor fixa
web/js/rede/isolamento.js @4                        # diagrama de isolamento da rede
web/js/rede/medicao_ficha.js @3                     # ficha de medição da rede

# --- cena 3D — configuração de renderização (luz, céu, material), não cromo ---
web/js/analise3d/painel.js @3                       # painel de análise 3D sobre o canvas
web/js/cena/camadas3d.js @1                         # camada 3D: cor de material padrão
web/js/cena/cena.js @5                              # cena 3D: iluminação, céu e névoa são configuração de renderização, não cromo
web/js/cena/documento.js @2                         # documento e configuração da cena 3D

# --- cor que É o dado — rampa de classificação, paleta categórica de gráfico, tema do inquilino ---
web/js/amc/motor_pagina.js @1                       # contorno de célula do motor AMC sobre o mapa
web/js/amc/pareto.js @2                             # parte PURA do Pareto: roda em Node, sem DOM nem CSSOM
web/js/amc/pareto_tela.js @2                        # tela de Pareto sobre o mapa: paint do MapLibre
web/js/amc/rampa.js @8                              # rampa de cor da classificação AMC: a cor é o dado
web/js/temas/tela.js @4                             # editor do tema do INQUILINO (L5-10): valor inicial de um tema que o usuário ainda não definiu
web/js/widgets/grafico.js @3                        # paleta categórica do widget de gráfico: cor para distinguir categoria

# --- SDK e extensão de exemplo — código de demonstração para desenvolvedor externo ---
web/ext/exemplo/semaforo/semaforo.js @1             # widget de exemplo de extensão: o semáforo é a demonstração
web/sdk/exemplos/10_catalogo_no_mapa.js @1          # exemplo de uso do SDK com MapLibre
web/sdk/plat.js @3                                  # SDK para desenvolvedor externo: cor de demonstração no exemplo de configuração
